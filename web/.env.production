# Production build config. The demo frontend talks to the live gateway.
# Both values are public (no secrets); set them here so Vercel builds inline
# them. Project-level env vars in the Vercel dashboard override these.
#
# Cloud Run, not Render, since 12 Sept. Render's free tier sleeps after fifteen
# idle minutes and the first call afterwards took 14.8 seconds, measured, which
# is what a judge would have watched before anything appeared. Cloud Run holds
# one warm instance and answers in about 0.4s.
#
# Render is still running and still works. To roll back, put the old URL here
# and redeploy WITHOUT the build cache:
#   https://coaching-engine-api.onrender.com/api/v1
NEXT_PUBLIC_USE_REAL_API=true
NEXT_PUBLIC_API_BASE_URL=https://coaching-engine-api-w5wg47f7gq-ew.a.run.app/api/v1
