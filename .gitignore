# ============================================================
#  NEVER COMMIT THESE
# ============================================================
# Real hotel SOPs. These are a real property's internal operations
# manuals, shared with Mary-Susan for prototype use only. They are
# somebody else's confidential material and they do not belong in a
# git repository, private or otherwise.
Docs/SOPs/
**/SOPs/
*SOP_Source*
*sop_source*

# Real staff data. Synthetic personas only, everywhere, always.
**/real-staff*
**/staff-export*
**/*-pii*

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json
gcp-key*.json
# Any service account key, wherever someone happens to drop it. The named
# patterns above only catch the filenames we thought of, and this repo is
# public: a leaked service account is a live credential to a billed cloud
# project, not an embarrassment to clean up later.
**/*-sa.json
**/sa-*.json
credentials/
*serviceaccount*.json
*.iam.gserviceaccount.com.json
secrets/

# ============================================================
#  Build output and noise
# ============================================================
# LaTeX
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.blog
*.bbl
*.blg

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
dist/
build/
.turbo/
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Local
*.local
.cache/
tmp/

# The warmed demo lines are the exception to the cache rule above. They must
# ship inside the image: a deployed container has an ephemeral filesystem, and
# the ElevenLabs free tier is 10,000 characters for the life of the account, so
# re-synthesising them on every cold start would spend the budget on dialogue
# we have already paid for. Eight files, about 1MB.
!services/api/.voice-cache/
!services/api/.voice-cache/*.mp3

# Google hands you a service account key named after the PROJECT, e.g.
# project-7ffd39d7-3c02-4599-ae9-644687ddfe43.json, which matches none of the
# patterns above. One arrived in the repo root and was one `git add -A` from
# being published. Any JSON at the repo root is now ignored by default: nothing
# the project legitimately tracks lives there.
/*.json
!/package.json
!/tsconfig.json
