OPENAI_API_KEY=sk-proj-REPLACE-ME
# Vertex AI. Needs BOTH of these plus the service account JSON file.
# GCP_PROJECT_ID is the project ID (a string like coaching-engine-2026),
# not the project NUMBER.
GCP_REGION=europe-west1
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
DATABASE_URL=postgresql://ce_app:ce_app@localhost:5433/coaching_engine
CE_ENV=local
